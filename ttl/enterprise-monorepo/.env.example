# github actors allowed to trigger admin workflows (comma-separated)
ADMIN_ALLOWED_ACTORS=octocat,your-github-username

# webhook for security alerts (slack, discord, etc.)
SECURITY_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-here

# database — points at pgbouncer, not postgres directly
DB_PROXY_HOST=localhost
DB_PROXY_PORT=6432
DB_NAME=production_metrics
DB_USER=pipeline_admin
DB_PASSWORD=changeme-use-strong-password
DB_SSLMODE=require

# mailgun transactional email
MAILGUN_DOMAIN=mg.your-domain.com
MAILGUN_API_KEY=key-your-mailgun-api-key-here
SENDER_EMAIL=noreply@your-domain.com
